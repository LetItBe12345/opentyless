# 语音识别（DashScope）基础配置
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# 文本精修（DeepSeek）配置；填写 DEEPSEEK_API_KEY 后默认使用 deepseek-flash（DeepSeek V4.1 Flash 关闭思考模式）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ASR 接口覆盖；默认走 DASHSCOPE_BASE_URL（qwen-audio-3.1-asr-flash 自动走原生多模态接口）
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash

# 整理模型。配置了 DEEPSEEK_API_KEY 时默认 deepseek-flash（自动关闭思考模式）；未配置时回退 qwen-plus
FLASH_API_URL=
FLASH_API_KEY=
FLASH_MODEL=deepseek-flash

# 录音命令。默认优先 ffmpeg，其次 arecord（支持带引号的路径和参数）
RECORDER_CMD=

# ASR 附加请求体，JSON 字符串；会 merge 到请求顶层
ASR_EXTRA_FORM_JSON=

# 整理请求附加 JSON；默认已自动附加 response_format={"type":"json_object"}、temperature=0.1、seed=7 及非思考参数
FLASH_EXTRA_BODY_JSON=

# 覆盖整理阶段的 system prompt；留空时默认内置 Typeless 风格口播精修规则（激进清口水词、消解自我纠正、自动分条目 + Few-Shot 示例）
FLASH_PROMPT=

# 是否自动把整理后的文本复制到剪贴板
AUTO_COPY_TO_CLIPBOARD=true

# 剪贴板命令。为空时自动检测 wl-copy / xclip / pbcopy
CLIPBOARD_COMMAND=

# 是否发送 Linux 桌面通知（notify-send）
ENABLE_NOTIFICATIONS=true

# 结果输出目录。留空时默认使用 ~/.local/share/opentyless/outputs
OUTPUT_DIR=

# 守护进程运行目录、状态目录、Unix socket。留空时默认使用 XDG 绝对路径
RUN_DIR=
STATE_DIR=
SOCKET_PATH=

# Native Qwen-Audio ASR: set ASR_MODEL=qwen-audio-3.1-asr-flash.
# Empty ASR_API_URL derives the native endpoint from DASHSCOPE_BASE_URL.
# JSON object mapping reviewed terms to integer weights 1–5; also used by cleanup.
ASR_VOCABULARY_FILE=
# Domain context (up to 400 characters); leave empty to use built-in bilingual tech dictation context.
ASR_CONTEXT=
