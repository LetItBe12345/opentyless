# Fill in your own keys; never commit .env.
DASHSCOPE_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
DASHSCOPE_API_KEY=''

# DeepSeek cleanup key; enables DeepSeek V4.1 Flash (deepseek-flash) with thinking disabled.
DEEPSEEK_BASE_URL='https://api.deepseek.com'
DEEPSEEK_API_KEY=''

ASR_MODEL='qwen3-asr-flash'
FLASH_MODEL='deepseek-flash'
# Empty uses built-in Typeless-style spoken cleanup prompt.
FLASH_PROMPT=''
# Empty uses native AVAudioRecorder (system default microphone).
RECORDER_CMD=''
AUTO_COPY_TO_CLIPBOARD=true
# Empty auto-detects pbcopy on macOS.
CLIPBOARD_COMMAND=''
# Desktop notification integration currently applies to Linux only.
ENABLE_NOTIFICATIONS=false

# Native Qwen-Audio ASR: set ASR_MODEL=qwen-audio-3.1-asr-flash.
# Empty ASR_API_URL derives the native endpoint from DASHSCOPE_BASE_URL.
# JSON object mapping reviewed terms to integer weights 1–5; also used by cleanup.
ASR_VOCABULARY_FILE=
# Domain context (up to 400 characters); empty uses built-in bilingual tech context.
ASR_CONTEXT=
